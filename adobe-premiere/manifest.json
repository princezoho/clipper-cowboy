{
  "manifestVersion": 5,
  "id": "com.clippercowboy.universal-premiere",
  "name": "Universal Clipper",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "universalClipperPanel",
      "label": {
        "default": "Universal Clipper"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 720
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:47474"
      ]
    }
  }
}
